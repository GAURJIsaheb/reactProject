# Server environment (example)
# Copy to `server/.env` and fill real values.

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/offline_todo

# Auth (code supports JWT_SECRET, and falls back to SECRET)
JWT_SECRET=change-me
SECRET=change-me

# App URLs/ports
PORT=4000
FRONTEND_URL=http://localhost:5173

# Email (used by SQS mailer)
MAIL_USER=
MAIL_PASS=

# AWS (optional; required only if you use S3 uploads and/or SQS queue)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
SQS_QUEUE_URL=

